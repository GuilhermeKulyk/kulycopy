# Normalize line endings: LF in the repository, native on checkout where it matters for Windows tools.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf
*.sln text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.db binary
*.pfx binary
