<Window x:Class="KulyCopy.UI.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit item" Width="680" Height="500" MinWidth="360" MinHeight="220"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="Ctrl+S or F2 saves · Esc cancels" Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_Save" Click="OnSave" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            </StackPanel>
        </DockPanel>
        <TextBox x:Name="Editor" Style="{StaticResource EditorTextBox}" />
    </DockPanel>
</Window>
