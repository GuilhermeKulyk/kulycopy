<Window x:Class="KulyCopy.UI.ShowContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item content" Width="720" Height="540" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="FormatBox" Grid.Column="1" SelectionChanged="OnFormatChanged" />
            <TextBlock x:Name="InfoText" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="_Save as..." Click="OnSaveAs" Margin="0,0,8,0" />
            <Button Content="_Copy format" Click="OnCopyFormat" Margin="0,0,8,0" MinWidth="100" />
            <Button Content="Close" IsCancel="True" />
        </StackPanel>
        <Grid>
            <TextBox x:Name="TextView" Style="{StaticResource EditorTextBox}" IsReadOnly="True" FontFamily="Consolas" />
            <Border x:Name="ImageHost" Background="{DynamicResource ImageBackground}" Visibility="Collapsed"
                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="ImageView" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
