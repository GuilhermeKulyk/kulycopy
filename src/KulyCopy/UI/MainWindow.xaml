<Window x:Class="KulyCopy.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KulyCopy.UI"
        Title="KulyCopy" Width="560" Height="700" MinWidth="320" MinHeight="300"
        Icon="pack://application:,,,/Assets/kulycopy.ico" ShowInTaskbar="True"
        PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput"
        Deactivated="OnDeactivated" Closing="OnClosing"
        LocationChanged="OnGeometryChanged" SizeChanged="OnGeometryChanged">
    <Window.Resources>
        <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
        <ui:StringToVisibilityConverter x:Key="StrToVis" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Item" InputGestureText="Ctrl+N" Click="OnNewItem" />
                <Separator />
                <MenuItem Header="_Import Tab..." Click="OnImportTab" />
                <MenuItem Header="_Export Tab..." Click="OnExportTab" />
                <Separator />
                <MenuItem Header="_Preferences..." InputGestureText="Ctrl+P" Click="OnPreferences" />
                <MenuItem Header="C_ommands / Global Shortcuts..." InputGestureText="F6" Click="OnCommands" />
                <Separator />
                <MenuItem Header="Show _Clipboard Content" InputGestureText="Ctrl+Shift+C" Click="OnShowClipboard" />
                <MenuItem x:Name="MonitoringMenuItem" Header="_Disable Clipboard Storing" InputGestureText="Ctrl+Shift+X" Click="OnToggleMonitoring" />
                <MenuItem Header="P_rocess Clipboard" Click="OnProcessClipboard" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Ctrl+Q" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Sort Selected" InputGestureText="Ctrl+Shift+S" Click="OnSort" />
                <MenuItem Header="_Reverse Selected" InputGestureText="Ctrl+Shift+R" Click="OnReverse" />
                <Separator />
                <MenuItem Header="_Paste Items" InputGestureText="Ctrl+V" Click="OnPasteItems" />
                <MenuItem Header="_Copy Items" InputGestureText="Ctrl+C" Click="OnCopyItems" />
                <Separator />
                <MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="OnFind" />
            </MenuItem>
            <MenuItem Header="_Item">
                <MenuItem Header="_Activate (copy and paste)" InputGestureText="Enter" Click="OnActivate" />
                <MenuItem Header="_Move to Clipboard" InputGestureText="Ctrl+Enter" Click="OnCopyItems" />
                <MenuItem Header="_Show Content..." InputGestureText="F4" Click="OnShowContent" />
                <MenuItem Header="_Remove" InputGestureText="Delete" Click="OnRemove" />
                <MenuItem Header="_Edit" InputGestureText="F2" Click="OnEdit" />
                <MenuItem Header="Edit _Notes" InputGestureText="Shift+F2" Click="OnEditNotes" />
                <MenuItem Header="_Pin / Unpin" InputGestureText="Ctrl+Shift+P" Click="OnTogglePin" />
                <MenuItem Header="A_ction..." InputGestureText="F5" Click="OnAction" />
                <Separator />
                <MenuItem Header="Move to _Top" InputGestureText="Ctrl+Home" Click="OnMoveTop" />
                <MenuItem Header="Move _Up" InputGestureText="Ctrl+Up" Click="OnMoveUp" />
                <MenuItem Header="Move _Down" InputGestureText="Ctrl+Down" Click="OnMoveDown" />
                <MenuItem Header="Move to _Bottom" InputGestureText="Ctrl+End" Click="OnMoveBottom" />
                <Separator />
                <MenuItem x:Name="MoveToTabMenu" Header="Move to Ta_b" SubmenuOpened="OnMoveToTabMenuOpened">
                    <MenuItem Header="(no other tabs)" IsEnabled="False" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tabs">
                <MenuItem Header="_New Tab..." InputGestureText="Ctrl+T" Click="OnNewTab" />
                <MenuItem Header="_Rename Tab..." InputGestureText="Ctrl+F2" Click="OnRenameTab" />
                <MenuItem Header="Re_move Tab" InputGestureText="Ctrl+W" Click="OnRemoveTab" />
                <MenuItem Header="Tab _Item Limit..." Click="OnTabLimit" />
                <Separator />
                <MenuItem Header="Ne_xt Tab" InputGestureText="Right / Ctrl+Tab" Click="OnNextTab" />
                <MenuItem Header="_Previous Tab" InputGestureText="Left / Ctrl+Shift+Tab" Click="OnPrevTab" />
                <MenuItem Header="Move Tab _Left" InputGestureText="Ctrl+Shift+Left" Click="OnMoveTabLeft" />
                <MenuItem Header="Move Tab Ri_ght" InputGestureText="Ctrl+Shift+Right" Click="OnMoveTabRight" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard and Scripting Help" InputGestureText="F1" Click="OnHelp" />
                <MenuItem Header="Show _Log" Click="OnShowLog" />
                <Separator />
                <MenuItem Header="_About KulyCopy" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="8,6" Background="{DynamicResource TabBarBackground}"
                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
                <TextBlock Text="Type to search (regular expression)…" Margin="10,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource PlaceholderForeground}"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource StrToVis}, ConverterParameter=Invert}" />
            </Grid>
        </Border>

        <ListBox x:Name="TabBar" DockPanel.Dock="Top" Style="{StaticResource TabBarStyle}"
                 ItemContainerStyle="{StaticResource TabItemStyle}" ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}" ContextMenuOpening="OnTabContextMenuOpening">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Count}" Opacity="0.55" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox x:Name="ItemList" ItemsSource="{Binding SelectedTab.View}" SelectionMode="Extended"
                 ItemContainerStyle="{StaticResource HistoryItemStyle}" BorderThickness="0"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnItemDoubleClick" ContextMenuOpening="OnItemContextMenuOpening">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" MinWidth="22" Margin="2,1,8,0" FontSize="11" TextAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{DynamicResource RowNumberForeground}"
                                   Text="{Binding Row}"
                                   Visibility="{Binding ShowRowNumbers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Grid.Column="1">
                            <Border Background="{DynamicResource NotesBackground}" CornerRadius="3" Padding="6,2" Margin="0,0,0,4"
                                    HorizontalAlignment="Left" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource NotesForeground}" FontStyle="Italic" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                       TextWrapping="{Binding TextWrapping, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{DynamicResource ImageBackground}" CornerRadius="3" Padding="4" HorizontalAlignment="Left"
                                    Visibility="{Binding ShowImage, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding Thumbnail}" MaxHeight="140" MaxWidth="320" Stretch="Uniform" StretchDirection="DownOnly" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="📌" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Pinned"
                                   Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
