<Window x:Class="KulyCopy.UI.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KulyCopy.UI"
        Title="Preferences" Width="820" Height="640" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Click="OnOk" Style="{StaticResource AccentButton}" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Apply" Click="OnApply" />
        </StackPanel>

        <TabControl x:Name="Tabs">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox x:Name="AutostartCheck" Content="Start KulyCopy when I sign in to Windows" IsChecked="{Binding Autostart}" />
                        <TextBlock x:Name="AutostartHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                                   Text="Installed from the Microsoft Store: turn startup on or off in Windows Settings › Apps › Startup." />
                        <CheckBox Content="Show the main window at startup" IsChecked="{Binding ShowAtStartup}" />
                        <CheckBox Content="Ask for confirmation before exiting" IsChecked="{Binding ConfirmExit}" />
                        <CheckBox Content="Hide the main window when it loses focus" IsChecked="{Binding HideOnUnfocus}" />
                        <CheckBox Content="Keep the main window always on top" IsChecked="{Binding AlwaysOnTop}" />
                        <Separator Margin="0,10" />
                        <CheckBox Content="Paste into the previous window after activating an item (Enter)" IsChecked="{Binding PasteAfterActivate}" />
                        <CheckBox Content="Hide the main window after activating an item" IsChecked="{Binding HideAfterActivate}" />
                        <CheckBox Content="Move items to the top when copied or activated" IsChecked="{Binding MoveItemToTop}" />
                        <Separator Margin="0,10" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Clipboard tab name:" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ClipboardTab}" Style="{StaticResource Field}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="New clipboard content is stored in this tab (created automatically)." />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Script timeout (seconds):" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ScriptTimeoutSeconds}" Style="{StaticResource Field}" Width="90" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Maximum number of items per tab:" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxItems}" Style="{StaticResource Field}" Width="90" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Oldest unpinned items are removed when a tab exceeds this limit. Each tab can override it (Tabs › Tab Item Limit)." />
                        <Separator Margin="0,6,0,10" />
                        <TextBlock Text="Store the following formats:" Margin="0,0,0,4" />
                        <CheckBox Content="Plain text" IsChecked="{Binding StoreText}" />
                        <CheckBox Content="Rich text (HTML)" IsChecked="{Binding StoreHtml}" />
                        <CheckBox Content="Rich text (RTF)" IsChecked="{Binding StoreRtf}" />
                        <CheckBox Content="Images (saved as PNG)" IsChecked="{Binding StoreImages}" />
                        <CheckBox Content="Copied files and folders" IsChecked="{Binding StoreFiles}" />
                        <StackPanel Style="{StaticResource Row}" Margin="0,8,0,3">
                            <TextBlock Text="Ignore images larger than (KB):" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxImageSizeKb}" Style="{StaticResource Field}" Width="90" />
                        </StackPanel>
                        <Separator Margin="0,10" />
                        <CheckBox Content="Show a notification when a new item is stored" IsChecked="{Binding Notifications}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Notification duration (seconds):" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NotificationSeconds}" Style="{StaticResource Field}" Width="90" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Theme:" Style="{StaticResource FieldLabel}" />
                            <ComboBox Width="220" SelectedValue="{Binding Theme}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Follow Windows setting" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Font family:" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FontFamily}" Style="{StaticResource Field}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Font size:" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FontSize}" Style="{StaticResource Field}" Width="90" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Editor font family:" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditorFontFamily}" Style="{StaticResource Field}" />
                        </StackPanel>
                        <Separator Margin="0,10" />
                        <CheckBox Content="Show row numbers" IsChecked="{Binding ShowRowNumbers}" />
                        <CheckBox Content="Wrap long lines in the item list" IsChecked="{Binding TextWrap}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Preview lines per item:" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxPreviewLines}" Style="{StaticResource Field}" Width="90" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Global shortcuts work in any application. Use names like Ctrl+Shift+V, Alt+F9, Win+Insert. Leave empty to disable. Shortcuts already used by another program cannot be registered." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Show/hide main window:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Hotkeys[ShowHide]}" Style="{StaticResource Field}" />
                            <TextBlock Grid.Row="1" Text="Show tray menu:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Hotkeys[ShowTrayMenu]}" Style="{StaticResource Field}" />
                            <TextBlock Grid.Row="2" Text="Paste next item:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Hotkeys[PasteNext]}" Style="{StaticResource Field}" />
                            <TextBlock Grid.Row="3" Text="Paste previous item:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Hotkeys[PastePrevious]}" Style="{StaticResource Field}" />
                            <TextBlock Grid.Row="4" Text="Enable/disable clipboard storing:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Hotkeys[ToggleMonitoring]}" Style="{StaticResource Field}" />
                            <TextBlock Grid.Row="5" Text="Edit clipboard:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Hotkeys[EditClipboard]}" Style="{StaticResource Field}" />
                            <TextBlock Grid.Row="6" Text="Paste as plain text:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Hotkeys[PasteAsPlainText]}" Style="{StaticResource Field}" />
                            <TextBlock Grid.Row="7" Text="Show clipboard content:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Hotkeys[ShowClipboardContent]}" Style="{StaticResource Field}" />
                            <TextBlock Grid.Row="8" Text="Create new item:" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Hotkeys[NewItem]}" Style="{StaticResource Field}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="Commands can also have global shortcuts: see the Commands tab." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tray">
                <StackPanel>
                    <CheckBox Content="Show the tray icon" IsChecked="{Binding ShowTray}" />
                    <TextBlock Style="{StaticResource Hint}" Text="Without the tray icon, use the global shortcut or run kulycopy again to open the window." />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="Number of recent items in the tray menu:" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TrayItems}" Style="{StaticResource Field}" Width="90" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="Tab shown in the tray menu (empty = clipboard tab):" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TrayTab}" Style="{StaticResource Field}" />
                    </StackPanel>
                    <CheckBox Content="Paste the item when chosen from the tray menu" IsChecked="{Binding TrayPaste}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Commands">
                <ui:CommandEditor x:Name="CommandEditor" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
