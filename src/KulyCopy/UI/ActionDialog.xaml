<Window x:Class="KulyCopy.UI.ActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Action" Width="700" Height="520" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Run a script with the selected items as input. Useful functions: data(), str(), selectedItemsData(), add(), write(), copy(), paste(), tab('Name'), execute('prog', 'arg'). The value of the last expression (or print()) is the output." />
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SaveOutput" Content="Save output as new item in tab:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="OutputTab" Grid.Column="1" Width="180" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=SaveOutput}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="_Run (Ctrl+Enter)" Click="OnRun" Style="{StaticResource AccentButton}" Margin="0,0,8,0" MinWidth="130" />
                <Button Content="Close" IsCancel="True" />
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="130" />
            </Grid.RowDefinitions>
            <TextBox x:Name="Script" Style="{StaticResource EditorTextBox}" FontFamily="Consolas" />
            <TextBlock Grid.Row="1" Text="Output:" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondary}" />
            <TextBox Grid.Row="2" x:Name="Output" Style="{StaticResource EditorTextBox}" IsReadOnly="True" FontFamily="Consolas" />
        </Grid>
    </DockPanel>
</Window>
