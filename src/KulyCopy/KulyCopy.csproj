<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>KulyCopy</RootNamespace>
    <AssemblyName>kulycopy</AssemblyName>
    <StartupObject>KulyCopy.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\kulycopy.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Authors>KulyCopy contributors</Authors>
    <Product>KulyCopy</Product>
    <Description>KulyCopy - open source clipboard manager for Windows, inspired by CopyQ.</Description>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms only for the tray icon; remove its implicit usings to avoid clashes with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KulyCopy.Core\KulyCopy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\kulycopy.ico" />
    <Resource Include="Assets\kulycopy-off.ico" />
  </ItemGroup>

</Project>
