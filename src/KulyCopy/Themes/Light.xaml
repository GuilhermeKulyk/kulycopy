<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme palette. Every brush here has a counterpart in Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F6F7F9" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#D7DAE0" />
    <SolidColorBrush x:Key="TextForeground" Color="#1E1F24" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B6F7A" />
    <SolidColorBrush x:Key="Accent" Color="#2D7FF9" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#DCEAFF" />
    <SolidColorBrush x:Key="SelectionForeground" Color="#1E1F24" />
    <SolidColorBrush x:Key="HoverBackground" Color="#EDF0F5" />
    <SolidColorBrush x:Key="TabBarBackground" Color="#EEF0F4" />
    <SolidColorBrush x:Key="TabActiveBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuBorder" Color="#D7DAE0" />
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#C5C8D0" />
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#A8ACB6" />
    <SolidColorBrush x:Key="PinForeground" Color="#D99A00" />
    <SolidColorBrush x:Key="NotesForeground" Color="#8A6D00" />
    <SolidColorBrush x:Key="NotesBackground" Color="#FFF8DC" />
    <SolidColorBrush x:Key="RowNumberForeground" Color="#9A9EA8" />
    <SolidColorBrush x:Key="PlaceholderForeground" Color="#9A9EA8" />
    <SolidColorBrush x:Key="EditorBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ImageBackground" Color="#ECEEF2" />
    <SolidColorBrush x:Key="DangerForeground" Color="#C93B3B" />
    <SolidColorBrush x:Key="SuccessForeground" Color="#2E8B57" />

</ResourceDictionary>
